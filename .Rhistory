#| include: false
options(
knitr.table.format = "html",
scipen = 999
)
#| label: grafico-porcentaje-sector
#| fig-cap: "Participación porcentual de los sectores laborales."
#| fig-width: 8
#| fig-height: 5
ggplot(tabla_sector, aes(x = "", y = fi, fill = Categoria)) +
geom_col(width = 1, color = "white") +
coord_polar(theta = "y") +
geom_text(
scales::percent(fi / sum(fi), accuracy = 0.1)
position = position_stack(vjust = 0.5)
#| label: grafico-porcentaje-sector
#| fig-cap: "Participación porcentual de los sectores laborales."
#| fig-width: 8
#| fig-height: 5
ggplot(tabla_sector, aes(x = "", y = fi, fill = Categoria)) +
geom_col(width = 1, color = "white") +
coord_polar(theta = "y") +
geom_text(
aes(label = scales::percent(fi / sum(fi), accuracy = 0.1)),
position = position_stack(vjust = 0.5)
) +
labs(
title = "Composición porcentual por sector",
fill = "Sector"
) +
theme_void()
install.packages("ggplot2")
library(ggplot2)
